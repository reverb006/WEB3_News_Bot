# ============================================================
# Web3 Security Radar — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# --- Gemini AI (Required for AI classification, analysis, PoCs & Q&A) ---
# Get your free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Primary Gemini model (fallback models are configured automatically)
GEMINI_MODEL=gemini-3.5-flash

# --- Telegram Bot (Optional, required for push alerts & interactive bot) ---
# 1. Message @BotFather on Telegram -> /newbot -> copy bot token
# 2. Message your new bot, then fetch your chat ID via:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates (or @userinfobot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
# Ignore articles older than this many hours when dispatching real-time alerts
ALERT_MAX_AGE_HOURS=400

# --- De.Fi REKT API (Optional) ---
DEFI_REKT_API_KEY=

# --- Database ---
DATABASE_PATH=data/radar.db

# --- Scheduler ---
RSS_COLLECTION_INTERVAL_MINUTES=15
# 24-hour HH:MM format in SCHEDULER_TIMEZONE
DAILY_DIGEST_TIME=10:00
# Any valid IANA timezone (e.g., UTC, America/New_York, Europe/London, Asia/Singapore)
SCHEDULER_TIMEZONE=UTC

# --- Web Dashboard ---
# Use 127.0.0.1 for local-only access, or 0.0.0.0 inside Docker containers
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/radar.log
